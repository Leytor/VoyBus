{
  "expo": {
    "name": "VoyBus",
    "slug": "voybus",
    "scheme": "voybus",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.voybus.demo"
    },
    "android": {
      "package": "cl.voybus.demo",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "VoyBus necesita usar la cámara para escanear el código QR del vehículo.",
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "VoyBus necesita tu ubicación durante los viajes del conductor."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
